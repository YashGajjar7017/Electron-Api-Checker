# API Checker Environment Configuration
# Copy this file to .env and fill in your values

# Development Settings
BROWSER=none
PORT=8000
MONITORING_INTERVAL=5000

# ==========================================
# GitHub OAuth Configuration (IMPORTANT!)
# ==========================================
# To enable GitHub sign-in, follow these steps:
# 1. Go to https://github.com/settings/developers
# 2. Create a new OAuth App
# 3. Get your Client ID and Client Secret
# 4. Set the Callback URL to: http://localhost:8000/auth/github/callback
# 5. Copy the values below

# React App GitHub OAuth (Frontend)
REACT_APP_GITHUB_CLIENT_ID=your_client_id_here
REACT_APP_GITHUB_CLIENT_SECRET=your_client_secret_here
REACT_APP_GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
REACT_APP_GITHUB_SCOPE=user:email read:user
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_GITHUB_AUTH_TOKEN=

# Backend GitHub OAuth (Server-side)
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
GITHUB_AUTH_TOKEN=

# ==========================================
# Backend Configuration
# ==========================================
BACKEND_URL=http://localhost:8000

# ==========================================
# Database Configuration
# ==========================================
MONOGDB_URI=mongodb://localhost:27017/api_checker

# ==========================================
# Security & Secrets
# ==========================================
# Generate random strings for these values
# Use: openssl rand -base64 32
SESSION_SECRET=0hLN9GS3oVIOIjr63bcb9FkGrA41gtMI
JWT_SECRET=6zbCLiRanshrJ0ckpjWNc2m5C4fjZTkZT4EEFZ8zpT5xgRineZEg2o6uIq33vbmy
JWT_EXPIRATION=1h

# ==========================================
# Demo Credentials
# ==========================================
# For testing without GitHub OAuth
LOGIN=USER
PASSWORD=PASSWORD@123

# ==========================================
# System Configuration
# ==========================================
MAINTENANCE_ID=PiPvJiFRwJMNmX8r842RDr

# ==========================================
# Production Settings (Uncomment for production)
# ==========================================
# REACT_APP_BACKEND_URL=https://api.yourdomain.com
# BACKEND_URL=https://api.yourdomain.com
# REACT_APP_GITHUB_REDIRECT_URI=https://yourdomain.com/auth/github/callback
# GITHUB_CALLBACK_URL=https://yourdomain.com/auth/github/callback
# MONOGDB_URI=mongodb://your-production-mongodb-uri
